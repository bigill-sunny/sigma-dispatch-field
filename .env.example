# Copy this file to ".env" in the project folder and uncomment ONE provider key.
# Never commit your ".env" file or share your API key publicly.

# Option 1: Groq (free tier, very fast, OpenAI-compatible)
# GROQ_API_KEY=gsk_your_key_here

# Option 2: Google AI Studio (Gemini API free tier)
# GEMINI_API_KEY=AIza_your_key_here

# Option 3: OpenRouter (free ":free" models)
# OPENROUTER_API_KEY=sk-or-your_key_here

# Option 4: Mistral La Plateforme (Experiment free tier)
# MISTRAL_API_KEY=your_key_here

# Optional overrides:
# SIGMA_AI_MODEL=llama-3.3-70b-versatile
# SIGMA_AI_URL=https://api.groq.com/openai/v1/chat/completions
# Optional name for automatic dispatch follow-ups
# SIGMA_DUTY_DISPATCHER=Jordan Ellis
# Required on Render. Set a private value at least 20 characters long.
# SIGMA_PILOT_KEY=
